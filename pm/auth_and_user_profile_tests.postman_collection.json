		{
			"name": "10. Пользователь 2 не может изменить профиль пользователя 1",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"// Пользователь 2 пытается подменить данные на свои, но с расчётом, что они применятся к пользователю 1",
							"const hackerName = `HACKER_${Math.floor(Math.random() * 10000)}`;",
							"pm.collectionVariables.set('hackerName', hackerName);",
							"console.log('=== [Pre-request] Попытка получения профиля пользователя 1 ===');",
							"console.log('Пытаемся установить firstName:', hackerName);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"console.log('=== [Response] PUT /api/user-profile с токеном пользователя 2 ===');",
							"console.log('Status:', pm.response.status, pm.response.code);",
							"console.log('Body:', pm.response.text());",
							"",
							"pm.test('Статус 200 OK (обновление прошло)', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Пользователь 2 обновил СВОЙ профиль, а не пользователя 1', function () {",
							"    const json = pm.response.json();",
							"    const hackerName = pm.collectionVariables.get('hackerName');",
							"    ",
							"    // Обновлённый профиль должен принадлежать пользователю 2",
							"    pm.expect(json.email).to.eql(pm.collectionVariables.get('email2'));",
							"    pm.expect(json.firstName).to.eql(hackerName);",
							"});",
							"",
							"const token1 = pm.collectionVariables.get('token1');",
							"const firstName1 = pm.collectionVariables.get('firstName1');",
							"",
							"pm.sendRequest({",
							"    url: pm.collectionVariables.get('baseUrl') + '/api/user-profile',",
							"    method: 'GET',",
							"    header: { 'Authorization': 'Bearer ' + token1 }",
							"}, function (err, res) {",
							"    console.log('=== [Nested] Проверка профиля пользователя 1 ===');",
							"    console.log('Status:', res.code);",
							"    console.log('Body:', res.text());",
							"    ",
							"    pm.test('Профиль пользователя 1 НЕ изменён', function () {",
							"        const json = res.json();",
							"        pm.expect(json.firstName).to.eql(firstName1);",
							"        pm.expect(json.email).to.eql(pm.collectionVariables.get('email1'));",
							"    });",
							"});"
