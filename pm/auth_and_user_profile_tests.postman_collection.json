				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const randomSuffix = Math.floor(Math.random() * 100000);",
							"const email1 = `user1_${randomSuffix}@example.com`;",
							"const password1 = `Pass_${randomSuffix}!2026`;",
							"",
							"pm.collectionVariables.set('email1', email1);",
							"pm.collectionVariables.set('password1', password1);",
							"",
							"console.log('=== [Pre-request] Регистрация пользователя 1 ===');",
							"console.log('Email:', email1);",
							"console.log('Password:', password1);"
						],
