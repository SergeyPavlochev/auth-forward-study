							"    pm.expect(json.token).to.be.a('string').and.not.empty;",
							"    pm.expect(json.userId).to.be.a('string').and.not.empty;",
							"    ",
							"    pm.collectionVariables.set('token1', json.token);",
							"    pm.collectionVariables.set('userId1', json.userId);",
							"    ",
							"    console.log('Сохранён token1:', json.token.substring(0, 20) + '...');",
							"    console.log('Сохранён userId1:', json.userId);",
							"});"
