						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"console.log('=== [Response] Регистрация пользователя 1 ===');",
							"console.log('Status:', pm.response.status, pm.response.code);",
							"console.log('Body:', pm.response.text());",
							"",
							"pm.test('Статус ответа 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
