			"name": "5. Изменение профиля пользователя 1",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const randomSuffix = Math.floor(Math.random() * 100000);",
							"const firstName = `Иван_${randomSuffix}`;",
							"const lastName = `Иванов_${randomSuffix}`;",
							"const phone = `+7${Math.floor(1000000000 + Math.random() * 9000000000)}`;",
							"",
							"pm.collectionVariables.set('firstName1', firstName);",
							"pm.collectionVariables.set('lastName1', lastName);",
							"pm.collectionVariables.set('phone1', phone);",
							"",
							"console.log('=== [Pre-request] Обновление профиля пользователя 1 ===');",
							"console.log('firstName:', firstName);",
							"console.log('lastName:', lastName);",
							"console.log('phone:', phone);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "test",
					"script": {
						"exec": [
							"console.log('=== [Response] PUT /api/user-profile пользователя 1 ===');",
							"console.log('Status:', pm.response.status, pm.response.code);",
							"console.log('Body:', pm.response.text());",
							"",
							"pm.test('Статус 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"",
							"pm.test('Профиль успешно обновлён', function () {",
							"    const json = pm.response.json();",
							"    pm.expect(json.firstName).to.eql(pm.collectionVariables.get('firstName1'));",
							"    pm.expect(json.lastName).to.eql(pm.collectionVariables.get('lastName1'));",
							"    pm.expect(json.phone).to.eql(pm.collectionVariables.get('phone1'));",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "PUT",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token1}}"
					}
				],
